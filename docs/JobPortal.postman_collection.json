                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{recruiterToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Full Stack Engineer (MERN)\",\n  \"description\": \"We are looking for a dedicated full-stack developer experienced in building scalable React and Node.js web applications.\",\n  \"type\": \"job\",\n  \"workMode\": \"remote\",\n  \"location\": \"Remote\",\n  \"salaryMin\": 800000,\n  \"salaryMax\": 1400000,\n  \"skills\": [\"React\", \"Node.js\", \"MongoDB\", \"Tailwind CSS\"],\n  \"experienceLevel\": \"entry\",\n  \"openings\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/jobs", "host": ["{{baseUrl}}"], "path": ["jobs"] }
          }
        },
        {
          "name": "Get Job By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/jobs/{{sampleJobId}}", "host": ["{{baseUrl}}"], "path": ["jobs", "{{sampleJobId}}"] }
          }
        },
        {
          "name": "Get My Posted Jobs (Recruiter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/jobs/my", "host": ["{{baseUrl}}"], "path": ["jobs", "my"] }
          }
        }
      ]
    },
