    {
      "name": "2. Companies",
      "item": [
        {
          "name": "Create Company (Recruiter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.company) {",
                  "    pm.collectionVariables.set('sampleCompanyId', json.data.company._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{recruiterToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Tech Solutions\",\n  \"description\": \"High growth tech firm providing AI and cloud infrastructure services.\",\n  \"website\": \"https://apextech.example.com\",\n  \"location\": \"Bengaluru, India\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/companies", "host": ["{{baseUrl}}"], "path": ["companies"] }
          }
        },
        {
          "name": "Get My Company (Recruiter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{recruiterToken}}" }],
            "url": { "raw": "{{baseUrl}}/companies/me", "host": ["{{baseUrl}}"], "path": ["companies", "me"] }
          }
        },
        {
          "name": "Get Company By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/companies/{{sampleCompanyId}}", "host": ["{{baseUrl}}"], "path": ["companies", "{{sampleCompanyId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Jobs",
      "item": [
        {
          "name": "Get Public Jobs (Search & Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs?search=react&type=job&workMode=remote&minSalary=500000&page=1&limit=10&sort=salary-desc",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "react" },
                { "key": "type", "value": "job" },
                { "key": "workMode", "value": "remote" },
                { "key": "minSalary", "value": "500000" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "salary-desc" }
              ]
            }
          }
        },
        {
          "name": "Post Job (Recruiter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
