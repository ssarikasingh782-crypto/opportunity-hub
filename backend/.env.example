# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/job_internship_portal

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_with_high_entropy_secret_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_MB=2

# Email (SMTP Configuration - Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Job Portal <noreply@jobportal.com>"
